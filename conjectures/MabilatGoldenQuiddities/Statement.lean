module

public import Mathlib.NumberTheory.Real.GoldenRatio
public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.Data.List.Rotate

@[expose] public section
namespace MabilatGoldenQuiddities
noncomputable section

/-- The integer k represents the multiple kφ in the additive group generated by φ. -/
def atom (k : ℤ) : Matrix (Fin 2) (Fin 2) ℝ := !![(k:ℝ)*Real.goldenRatio, -1; 1, 0]

/-- The last matrix in the list is the leftmost matrix in the product. -/
def matrix (w : List ℤ) := (w.reverse.map atom).prod

def Quiddity (w : List ℤ) : Prop := 0 < w.length ∧ (matrix w = 1 ∨ matrix w = -1)

def Dihedral (w v : List ℤ) : Prop := w.IsRotated v ∨ w.reverse.IsRotated v

/-- The summands are a::u++[b] and c::v++[d]. The nonempty interiors give
both summands length at least three, as in Definition 2.4. -/
def Reducible (w : List ℤ) : Prop := ∃ (a b c d : ℤ) (u v : List ℤ),
  u ≠ [] ∧ v ≠ [] ∧ Quiddity (c :: v ++ [d]) ∧ Dihedral w ((a+d) :: u ++ (b+c) :: v)

def Irreducible (w : List ℤ) : Prop := 3 ≤ w.length ∧ Quiddity w ∧ ¬ Reducible w

/-- Mabilat's classification conjecture following Proposition 3.9. -/
def Conjecture : Prop := ∀ w : List ℤ, Irreducible w ↔
  w = [1,1,1,1,1] ∨ w = [-1,-1,-1,-1,-1] ∨ ∃ k : ℤ, w = [0,k,0,-k] ∨ w = [k,0,-k,0]

end
end MabilatGoldenQuiddities
