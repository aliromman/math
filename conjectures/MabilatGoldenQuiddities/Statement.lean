module

public import Mathlib.NumberTheory.Real.GoldenRatio
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.Data.List.Rotate

@[expose] public section
namespace MabilatGoldenQuiddities
noncomputable section

/-- The integer k represents the multiple kx in the additive group generated by x. -/
def atom (x : ℝ) (k : ℤ) : Matrix (Fin 2) (Fin 2) ℝ := !![(k:ℝ)*x, -1; 1, 0]

def matrix (x : ℝ) (w : List ℤ) := (w.reverse.map (atom x)).prod

def Quiddity (x : ℝ) (w : List ℤ) : Prop :=
  0 < w.length ∧ (matrix x w = 1 ∨ matrix x w = -1)

def Dihedral (w v : List ℤ) : Prop := w.IsRotated v ∨ w.reverse.IsRotated v

/-- The summands are a::u++[b] and c::v++[d]. Their nonempty interiors give
both summands length at least three, as in Definition 2.4. -/
def Reducible (x : ℝ) (w : List ℤ) : Prop := ∃ (a b c d : ℤ) (u v : List ℤ),
  u ≠ [] ∧ v ≠ [] ∧ Quiddity x (c :: v ++ [d]) ∧ Dihedral w ((a+d) :: u ++ (b+c) :: v)

def Irreducible (x : ℝ) (w : List ℤ) : Prop := 3 ≤ w.length ∧ Quiddity x w ∧ ¬ Reducible x w

/-- Mabilat's conjecture following Proposition 3.9. -/
def Conjecture : Prop := ∀ w : List ℤ, Irreducible Real.goldenRatio w ↔
  w = [1,1,1,1,1] ∨ w = [-1,-1,-1,-1,-1] ∨ ∃ k : ℤ, w = [0,k,0,-k] ∨ w = [k,0,-k,0]

/-- A classification for the real Hecke parameters. -/
def HeckeClassification : Prop := ∀ q : ℕ, 4 ≤ q → ∀ w : List ℤ,
  Irreducible (2*Real.cos (Real.pi/q)) w ↔
    w = List.replicate q 1 ∨ w = List.replicate q (-1) ∨
    ∃ k : ℤ, w = [0,k,0,-k] ∨ w = [k,0,-k,0]

end
end MabilatGoldenQuiddities
