module

public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Data.Finset.Range
public import Mathlib.Data.Fintype.Fin
public import Mathlib.Data.Nat.EvenOddRec

@[expose] public section
namespace FenceRowmotion
open Finset

/-- Vertices start at zero. The shared vertices are a − 1, 2a − 1, and so on.
In a path two different vertices are comparable exactly when all intervening edges
belong to the same segment and point in the required direction. -/
def below (a x y : ℕ) : Bool := decide (x = y ∨
  (x < y ∧ (x + 1) / a = y / a ∧ (y / a) % 2 = 0) ∨
  (y < x ∧ (y + 1) / a = x / a ∧ (x / a) % 2 = 1))

def ground (a t : ℕ) := range (a * t - 1)

def Ideal (a t : ℕ) (I : Finset ℕ) : Prop :=
  I ⊆ ground a t ∧ ∀ x ∈ I, ∀ y ∈ ground a t, below a y x → y ∈ I

def minima (a t : ℕ) (I : Finset ℕ) : Finset ℕ :=
  let outside := ground a t \ I
  outside.filter fun x => ∀ y ∈ outside, below a y x → x = y

/-- Rowmotion takes the order ideal generated by the minimal elements of its complement. -/
def row (a t : ℕ) (I : Finset ℕ) : Finset ℕ :=
  let M := minima a t I
  (ground a t).filter fun y => ∃ x ∈ M, below a y x

def next {p : ℕ} (i : Fin p) : Fin p :=
  ⟨(i.val + 1) % p, Nat.mod_lt _ (Nat.zero_le _ |>.trans_lt i.isLt)⟩

def Orbit {p : ℕ} (a t : ℕ) (L : Fin p → Finset ℕ) : Prop :=
  0 < p ∧ Function.Injective L ∧ (∀ i, Ideal a t (L i)) ∧ ∀ i, row a t (L i) = L (next i)

/-- Elizalde, Plante, Roby and Sagan, Conjecture 5.4(b). -/
def HalfMesic : Prop := ∀ a t : ℕ, 2 ≤ a → Odd t → ∀ p : ℕ, ∀ L : Fin p → Finset ℕ,
  Orbit a t L → 2 * (∑ i, (L i).card) = p * (a * t - 1)

end FenceRowmotion
